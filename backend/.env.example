# SecureConfigAI configuration. Copy to .env and edit. Never commit .env.
# Every value below is a placeholder and is safe to keep in version control.

APP_ENV=development
APP_VERSION=4.0.0
LOG_LEVEL=INFO
LOG_JSON=true

# --------------------------------------------------------------------------- database
# PostgreSQL is required for normal application use; a SQLite URL is refused unless
# APP_ENV=test. Use a dedicated, least-privilege role (not "postgres"), and give it
# CONNECT + DML on the application schema only. Replace CHANGE_ME locally.
DATABASE_URL=postgresql+psycopg://secureconfigai:CHANGE_ME@localhost:5432/secureconfigai_db
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# Automated tests. Set this to a *separate* database so the suite can never touch the
# application data. Leave it empty to run the suite against a throwaway SQLite file.
#   set TEST_DATABASE_URL=postgresql+psycopg://secureconfigai:CHANGE_ME@localhost:5432/secureconfigai_test
# TEST_DATABASE_URL=

# --------------------------------------------------------------------------- secrets
# Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# In production the service refuses to start while this is a placeholder or shorter
# than 32 characters.
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_ISSUER=secureconfigai
JWT_AUDIENCE=secureconfigai-api
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
REFRESH_ROTATION=true
REFRESH_REUSE_DETECTION=true

# --------------------------------------------------------------------------- passwords
PASSWORD_MIN_LENGTH=12
# bcrypt hashes at most 72 bytes. Nothing is silently truncated: a longer password is
# rejected with a validation error, which is why this is a byte cap and not a style rule.
PASSWORD_MAX_LENGTH=72
PASSWORD_REQUIRE_LETTER=true
PASSWORD_REQUIRE_DIGIT=true
PASSWORD_REQUIRE_SYMBOL=false
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15

# --------------------------------------------------------------------------- web policy
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SECURITY_HEADERS_ENABLED=true
HSTS_ENABLED=false
RATE_LIMIT_ENABLED=true

# --------------------------------------------------------------------------- uploads
MAX_UPLOAD_BYTES=67108864
ALLOWED_UPLOAD_EXTENSIONS=.json,.zip
# Raw evidence is not stored in the database: only the control-evidence projection is.
# Enable this only when the deployment also enforces a retention policy.
STORE_RAW_EVIDENCE=false

# --------------------------------------------------------------------------- assessment
SCAN_JOB_WORKERS=2
SCAN_MAX_QUEUE=20
SCAN_BUDGET_SECONDS=120
SCAN_PARALLEL=4
SCAN_INVENTORY=false
SCANNER_ELEVATE=false
SCAN_STALE_AFTER_SECONDS=900

# --------------------------------------------------------------------------- retention
RETENTION_SCAN_DAYS=365
RETENTION_AUDIT_DAYS=730
RETENTION_REPORT_DAYS=180
# Enforce the windows above automatically at startup and on every maintenance cycle.
# Off by default: deleting data is an explicit decision. A dry run is always available
# at POST /api/v1/admin/maintenance/retention.
RETENTION_ENFORCEMENT_ENABLED=false

# --------------------------------------------------------------------------- evidence provenance
# Optional shared secret (32+ characters) used to verify an HMAC envelope on uploaded
# snapshots. Set the same value on the scanner (--signing-key or EVIDENCE_SIGNING_KEY)
# and on this service. When it is empty, evidence is reported as integrity-checked
# only and no authenticity claim is made anywhere in the API or the UI.
EVIDENCE_SIGNING_KEY=

# --------------------------------------------------------------------------- audit chain
# V4: optional server-side key (generate: python -c "import secrets; print(secrets.token_urlsafe(48))").
# When set, audit chain entries are committed with keyed HMAC-SHA-256. The key lives
# here only — never in the database — so an attacker with database write access can
# no longer recompute the chain after rewriting history. Leave empty for the V3
# behaviour (plain SHA-256, self-attestable).
AUDIT_CHAIN_HMAC_KEY=

# --------------------------------------------------------------------------- AI (advisory)
# Leave the key empty to run without a provider: scanning, controls, scores, findings
# and reports are fully deterministic. The AI only ever writes explanatory text.
AI_ENABLED=true
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
AI_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=2
# V4: maximum concurrent in-flight provider calls; extra requests fall back to the
# deterministic path instead of pinning the request thread pool.
AI_MAX_CONCURRENT_CALLS=4
AI_CACHE_TTL_MINUTES=60
AI_REDACT_PII=true


GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_MODEL=gemini-3.8-flash