# SecureConfigAI frontend environment
#
# Leave VITE_API_BASE_URL unset during development: the vite dev server proxies
# /api and /health to http://127.0.0.1:8001, so no CORS configuration is needed.
#
# Set it only when the API lives on another origin (staging/production builds).
# Example: VITE_API_BASE_URL=https://api.example.internal
VITE_API_BASE_URL=

# Optional: point the dev proxy at a non-default backend port.
# VITE_DEV_BACKEND_ORIGIN=http://127.0.0.1:8001
